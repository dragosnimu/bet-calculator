# BET Calculator
# Nu e nevoie de cheie API — scraping direct pe bvb.ro
PORT=3000
NODE_ENV=production

# ── Alerte Telegram ─────────────────────────────────────────────
# Bot creat cu @BotFather -> tokenul primit:
TELEGRAM_BOT_TOKEN=
# ID-ul chat-ului unde vin alertele (scrie /start botului, apoi vezi README):
TELEGRAM_CHAT_ID=

# ── Setari alerte (optional, au valori implicite) ───────────────
ALERT_INTERVAL_MIN=15        # la cate minute se verifica
ALERT_DROP_STEP=1            # pragul de scadere in %
ALERT_TZ=Europe/Bucharest    # fusul orar pentru programul bursei
MARKET_OPEN_HOUR=10          # ora deschidere bursa
MARKET_CLOSE_HOUR=18         # ora inchidere bursa
