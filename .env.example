# BET Calculator
# Nu e nevoie de cheie API — scraping direct pe bvb.ro
PORT=3000
NODE_ENV=production

# ── Alerte Telegram ─────────────────────────────────────────────
# Bot creat cu @BotFather -> tokenul primit:
TELEGRAM_BOT_TOKEN=
# ID-ul chat-ului unde vin alertele (scrie /start botului, apoi vezi README):
TELEGRAM_CHAT_ID=

# ── Setari alerte (optional, au valori implicite) ───────────────
ALERT_INTERVAL_MIN=15        # la cate minute se verifica
ALERT_DROP_STEP=3            # pragul de scadere in % (alerta doar la scaderi >= 3%)
ALERT_RISE_STEP=1            # pragul de crestere in %
ALERT_TZ=Europe/Bucharest    # fusul orar pentru programul bursei
MARKET_OPEN_HOUR=10          # ora deschidere bursa
MARKET_CLOSE_HOUR=18         # ora inchidere bursa

# ── Alerte de trend intraday (per actiune, cu grafic) ───────────
TREND_ENABLED=true           # activeaza detectia de trend
TREND_WINDOW=8               # cate esantioane in fereastra (8 = ~2h)
TREND_MIN_MOVE=1.0           # mutare minima pe fereastra ca sa fie "trend clar", %
TREND_MIN_R2=0.6             # cat de "curat" trebuie sa fie trendul (0..1)

# ── Semnale tehnice (Faza 1: EMA/RSI/MACD/Bollinger/breakout) ───
SIGNAL_ENABLED=true          # activeaza semnalele tehnice
SIGNAL_STRONG_BUY=55         # prag scor pt. SEMNAL PUTERNIC DE CUMPARARE (0..100)
SIGNAL_STRONG_SELL=-55       # prag scor pt. SEMNAL PUTERNIC DE VANZARE/RISC
SIGNAL_MIN_CONFIRMS=3        # confirmari minime pt. un semnal puternic
SIGNAL_COOLDOWN_MIN=45       # minute intre semnale pt. aceeasi actiune (anti-spam)

# ── Verdict de continuare trend (atasat fiecarei alerte de pret) ─
VERDICT_MIN_BARS=30          # bare minime (15 min) pt. un verdict ferm; sub asta, doar alerta simpla

# ── Faza 2: anunturi oficiale emitenti (rapoarte curente BVB) ───
ANNOUNCE_ENABLED=true        # alerta instant la un raport nou al unei actiuni urmarite

# ── Faza 3: sentiment stiri (Google News RSS + scorare Claude) ──
SENTIMENT_ENABLED=true       # activeaza analiza de sentiment din stiri
ANTHROPIC_API_KEY=           # cheia Claude API (fara ea, sentimentul e dezactivat)
SENTIMENT_MODEL=claude-opus-5  # model pt. scorare. Mai ieftin: claude-haiku-4-5
SENTIMENT_MIN_ABS=0.5        # prag |scor| (0..1) pt. a trimite alerta de sentiment
NEWS_LOOKBACK_DAYS=3         # cate zile in urma se cauta stiri
NEWS_EVERY_TICKS=4           # la cate tick-uri se verifica stirile (4 = ~o data pe ora)
